# Copy via scripts/dev-env.sh (generates random values). Never commit a real .env.
POSTGRES_PASSWORD=
LIFEBOAT_DATABASE_URL=postgresql+psycopg://lifeboat:<password>@localhost:5432/lifeboat
LIFEBOAT_JWT_SECRET=
LIFEBOAT_BOOTSTRAP_ADMIN_PASSWORD=
LIFEBOAT_BOOTSTRAP_OPERATOR_PASSWORD=
LIFEBOAT_BOOTSTRAP_APPROVER_PASSWORD=
LIFEBOAT_BOOTSTRAP_VIEWER_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional - LLM copilot (falls back to the rule engine when unset)
# LIFEBOAT_ANTHROPIC_API_KEY=
# LIFEBOAT_COPILOT_MODEL=claude-opus-5-5

# Cloud mode (LIFEBOAT_PROVIDER_MODE=cloud) - values come from `terraform output lifeboat_settings`
# LIFEBOAT_PROVIDER_MODE=cloud
# LIFEBOAT_AWS_REGION=us-east-1
# LIFEBOAT_AWS_RDS_INSTANCE_ID=
# LIFEBOAT_AWS_ROUTE53_ZONE_ID=
# LIFEBOAT_AWS_RECORD_NAME=
# LIFEBOAT_AWS_APP_ENDPOINT=https://
# LIFEBOAT_AZURE_SUBSCRIPTION_ID=
# LIFEBOAT_AZURE_RESOURCE_GROUP=
# LIFEBOAT_AZURE_PG_SERVER=
# LIFEBOAT_AZURE_APP_ENDPOINT=https://
# LIFEBOAT_PRIMARY_DB_DSN=
# LIFEBOAT_SECONDARY_DB_DSN=
